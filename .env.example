# Copy to .env before running: docker-compose up -d
# docker-compose reads this file automatically; secrets never live in source code.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=smartmatch
DB_USER=smartmatch
DB_PASSWORD=change-me-app
# Host port for MySQL (3306 is often taken by a local install).
DB_PUBLISHED_PORT=3307

# ---------- Backend (Go) ----------
# Required, at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
GEMINI_API_KEY=
BACKEND_PUBLISHED_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Frontend (Vite/React) ----------
FRONTEND_PUBLISHED_PORT=5173
# Leave empty so the browser calls /api on the same origin and nginx proxies
# it to the backend container. Set an absolute URL only when the API is
# deployed on a different domain.
VITE_API_URL=
