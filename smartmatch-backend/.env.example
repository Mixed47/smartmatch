# Local (non-Docker) backend configuration: copy to .env
# Docker deployments get these values from the root .env via docker-compose.

PORT=8080

# Option A: managed database connection string.
# DB_URL="user:password@tcp(host:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local&tls=skip-verify"

# Option B: discrete variables (used when DB_URL is empty).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartmatch
DB_USER=smartmatch
DB_PASSWORD=
# "skip-verify" or "true" for managed databases that require TLS.
DB_TLS=

# Required. At least 32 characters, no hardcoded fallback exists in the code.
JWT_SECRET=
GEMINI_API_KEY=

# "*" or a comma separated list of origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
